# ===========================================
# GNOVIUM — Master Environment Configuration
# ===========================================
# Copy this file or individual sections to .env.local in each workspace.
# All values shown are development defaults.

# ─── Shared (all apps) ─────────────────────────────────────
# Base URLs — override per environment
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
NEXT_PUBLIC_CLOUD_WEB_URL=http://localhost:3001
NEXT_PUBLIC_DOCS_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:5000

# Base paths — usually unchanged
NEXT_PUBLIC_LANDING_BASE_PATH=
NEXT_PUBLIC_CLOUD_WEB_BASE_PATH=/app
NEXT_PUBLIC_DOCS_BASE_PATH=/api/v1/docs
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# ─── cloud-web only ────────────────────────────────────────
# Google OAuth (leave empty to disable Google sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Backend (Flask) ───────────────────────────────────────
# Mode: "local" (SQLite, local-app only) or "cloud" (PostgreSQL, cloud-web + API)
GNOVIUM_MODE=local

# PostgreSQL (REQUIRED for cloud mode)
# Production:   Neon DB — postgresql://user:pass@ep-xxx.neon.tech/gnovium?sslmode=require
# Development:  Local PG — postgresql://postgres:postgres@localhost:5432/gnovium
# Docker:       docker compose up -d postgres
DATABASE_URL=

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# CORS & Hosts
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate limiting
RATELIMIT_DEFAULT=1200 per minute
REQUIRE_REDIS=false

# Database pool (cloud mode)
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=4
DB_POOL_RECYCLE=280

# AWS S3 (cloud mode only)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=gnovium

# ─── Local App (Electron) ─────────────────────────────────
# Flask backend (renderer → main process)
VITE_FLASK_HOST=127.0.0.1
VITE_FLASK_PORT=5001

# Vite dev server
VITE_DEV_PORT=5173

# Cloud services (for sync/auth)
VITE_GNOVIUM_SERVER_URL=https://app.gnovium.com
VITE_GNOVIUM_API_URL=https://api.gnovium.com/v1
VITE_GNOVIUM_AUTH_URL=https://app.gnovium.com/auth
VITE_GNOVIUM_LANDING_URL=https://gnovium.com
VITE_GNOVIUM_ISSUES_URL=https://github.com/GauravKaloliya/GNOVIUM/issues
