# Deployment
# Possible override files (see repository root):
#   .env.cloud.dev   — local PostgreSQL for cloud-mode development (copy to .env.cloud)
#   .env.production  — full production config template for Vercel/cloud deployment
GNOVIUM_MODE=local
VERCEL=0

# Core Security
SECRET_KEY=change-me-to-random-secret
JWT_SECRET_KEY=change-me-to-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database
DATABASE_URL=sqlite:///local.db

# Cloud (only needed when GNOVIUM_MODE=cloud)
CLOUD_API_URL=https://api.gnovium.com
CLOUD_DATABASE_URL=postgresql://user:pass@host:5432/gnovium
REDIS_URL=redis://localhost:6379/0

# AWS S3 (cloud mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=gnovium-uploads
S3_PRESIGN_EXPIRY=3600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5001

# Rate Limiting
RATE_LIMIT_STORAGE_URL=memory://
AUTH_WRITE_LIMIT=5 per minute
PASSWORD_RESET_LIMIT=3 per minute
DESTRUCTIVE_LIMIT=10 per minute
FILE_UPLOAD_LIMIT=10 per minute
FILE_DOWNLOAD_LIMIT=60 per minute
STRICT_LIMIT=30 per minute
STANDARD_LIMIT=120 per minute
LENIENT_LIMIT=300 per minute

# File Upload
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.svg,.pdf,.doc,.docx,.txt,.md,.csv,.json,.zip

# ZIP encryption
ZIP_ENCRYPTION_KEY=change-me-to-32-char-key-for-aes-gcm

# Local mode
LOCAL_DB_PATH=./local.db
LOCAL_STORAGE_PATH=./uploads

# PostgreSQL Pool (cloud mode)
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30

# Processing Pipeline
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
MAX_IMAGE_DIMENSION=4096
THUMBNAIL_SIZE=256
PREVIEW_SIZE=1024

# Caching
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Embedding Model
EMBEDDING_MODEL=BGE-M3
EMBEDDING_DIMENSION=1024
