# Gnovium Cloud Web — Environment Variables
# Copy this to .env.local for local development

# ─── App URLs ──────────────────────────────────────────────
# Frontend URL (this app)
NEXT_PUBLIC_CLOUD_WEB_URL=http://localhost:3000
# Base path for the frontend (served under /app)
NEXT_PUBLIC_CLOUD_WEB_BASE_PATH=/app

# ─── API Configuration ─────────────────────────────────────
# Flask backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000
# API base path prefix
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_AUTH_API_URL=https://api.gnovium.com

# ─── Third-Party ───────────────────────────────────────────
# Google OAuth Client ID (leave empty to disable Google sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── External Links ────────────────────────────────────────
# Documentation URL
NEXT_PUBLIC_DOCS_URL=http://localhost:3002
# Landing page URL
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
