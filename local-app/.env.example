# ===========================================
# GNOVIUM Local App - Environment Configuration
# ===========================================
# Copy this file to .env.development or .env.production
# Vite only exposes vars with VITE_ prefix to the renderer

# === FLASK BACKEND ===
VITE_FLASK_HOST=127.0.0.1
VITE_FLASK_PORT=5001

# === VITE DEV SERVER ===
VITE_DEV_PORT=5173

# === CLOUD SERVICES ===
VITE_GNOVIUM_SERVER_URL=https://app.gnovium.com
VITE_GNOVIUM_API_URL=https://api.gnovium.com/v1
VITE_GNOVIUM_AUTH_URL=https://app.gnovium.com/auth
VITE_GNOVIUM_LANDING_URL=https://gnovium.com

# === BUILD ===
VITE_GNOVIUM_ISSUES_URL=https://github.com/GauravKaloliya/GNOVIUM/issues
